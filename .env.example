# VerityOS Environment Configuration Template
# Copy this file to .env and customize. NEVER commit .env to version control!

# System Environment (development | testing | production)
VERITYOS_ENV=development

# Execution Mode (mock | live)
# In mock mode, deterministic datasets from agents/mocks.py are used
VERITYOS_DEFAULT_MODE=mock

# Logging Level (DEBUG | INFO | WARNING | ERROR)
VERITYOS_LOG_LEVEL=INFO

# Backend API Configuration (Member 3)
API_HOST=127.0.0.1
API_PORT=8000

# Optional Live Providers (Leave empty or populate for live mode)
# Live Web Search Provider (e.g. Tavily, SerpAPI, DuckDuckGo)
RESEARCH_API_KEY=your_research_api_key_here

# Live LLM API Key (e.g. Gemini, OpenAI)
LLM_API_KEY=your_llm_api_key_here

# Optional Database URL (PostgreSQL + pgvector for stretch phase)
DATABASE_URL=postgresql://user:password@localhost:5432/verityos

# -------------------------------------------------------
# VerityOS — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# -------------------------------------------------------

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Pipeline mode (true = use built-in mock; false = import agents.orchestrator)
USE_MOCK_PIPELINE=true

# Authentication settings (Member 3)
AUTH_DB_PATH=backend/data/auth.db
AUTH_TOKEN_EXPIRE_HOURS=24
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret
REQUIRE_AUTH_FOR_ANALYZE=false

# Member 1 — Agent / LLM keys (set by Member 1)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Member 2 — Trust Engine config (set by Member 2, lives in trust_engine/config.py)
